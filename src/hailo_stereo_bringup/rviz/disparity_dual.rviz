Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: SGBM disparity (CPU)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereo/disparity_viz
      Normalize Range: false
      Min Value: 0
      Max Value: 255
      Median window: 1
      Queue Size: 1
      Transport Hint: raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: StereoNet disparity (Hailo)
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /stereo/disparity_hailo_viz
      Normalize Range: false
      Min Value: 0
      Max Value: 255
      Median window: 1
      Queue Size: 1
      Transport Hint: raw
      Value: true
  Enabled: true
  Global Options:
    Background Color: 24; 24; 28
    Fixed Frame: stereo_left_optical_frame
    Frame Rate: 24
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
  Value: true
Window Geometry:
  Height: 900
  Width: 1440
  X: 0
  Y: 0
