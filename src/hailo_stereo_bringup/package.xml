<?xml version="1.0"?>
<package format="3">
  <name>hailo_stereo_bringup</name>
  <version>0.1.0</version>
  <description>Hailo-8 StereoNet parallel depth pilot, for comparison against CPU SGBM.</description>
  <maintainer email="qqqq@example.com">qqqq</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>camera_ros</exec_depend>
  <exec_depend>drone_stereo_bringup</exec_depend>
  <exec_depend>image_geometry</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>stereo_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
