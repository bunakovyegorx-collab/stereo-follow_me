<?xml version="1.0"?>
<package format="3">
  <name>yolo_person_car</name>
  <version>0.1.0</version>
  <description>NCNN-backed YOLO person and car detector for ROS 2 camera topics.</description>
  <maintainer email="qqqq@example.com">qqqq</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>camera_ros</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
